{
  "expo": {
    "name": "Skaneo",
    "slug": "skaneo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/skaneo.png",
    "scheme": "skaneo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/skaneo.png",
        "backgroundImage": "./assets/images/skaneo.png",
        "monochromeImage": "./assets/images/skaneo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.maxjohn.skaneo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/skaneo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/skaneo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b657334f-2fe9-4d50-96d9-e47ca83094eb"
      }
    },
    "owner": "maxjohn"
  }
}
